APP_NAME=Prospecta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=prospecta
# DB_USERNAME=root
# DB_PASSWORD=

# Render Postgres (escolha UMA opção):
# Opção A — URL (Internal Database URL do painel Render):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# (ou DATABASE_URL=... — o app aceita os dois)
# Opção B — campos separados (NÃO coloque a URL no DB_HOST):
# DB_CONNECTION=pgsql
# DB_HOST=dpg-xxxxx-a
# DB_PORT=5432
# DB_DATABASE=prospecta
# DB_USERNAME=prospecta
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mídia persistente (Render): supabase | local
PROSPECTA_STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=prospecta

AWS_ACCESS_KEY_ID=
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@prospecta.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Prospecta — ver docs/ENV.md (nunca commitar secrets reais)
# -----------------------------------------------------------------------------

MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE_URL="${MAPBOX_STYLE_URL}"

GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_DIRECTIONS_BASE_URL=https://www.google.com/maps/dir/
VITE_GOOGLE_PLACES_API_KEY=

VIACEP_URL_BASE=https://viacep.com.br/ws
IBGE_URL_BASE=https://servicodados.ibge.gov.br/api/v1/localidades

ROTA_FAIXA_LNG=0.004
ROTA_LIMITE_PARADAS=12
ROTA_JANELA_OURO=12
ROTA_PREDIO_METROS=50
ROTA_RAIO_PROSPECCAO_KM=2
ROTA_RAIO_POS_VENDA_KM=15
ROTA_DURACAO_VISITA_MIN=30
ROTA_VELOCIDADE_KMH=20
ROTA_ALMOCO_INICIO=12:00
ROTA_ALMOCO_DURACAO_MIN=60

RECEITA_WS_DRIVER=mock
# Ex.: https://www.receitaws.com.br/v1/cnpj  (ou provedor compatível)
RECEITA_WS_URL_BASE=
RECEITA_WS_TOKEN=
RECEITA_WS_TIMEOUT=10

TRACKING_INTERVALO_MS=12000
TRACKING_JANELA_MINUTOS=15
TRACKING_ALERTA_SEM_SINAL_SEGUNDOS=180
TRACKING_ALERTA_PARADO_MS=1
META_VISITAS_DIA=8

# Portfolio/Render: /admin/demo regenera GPS ao vivo (false em prod real)
DEMO_SEED_ENABLED=false

PWA_NOME="${APP_NAME}"
PWA_THEME_COLOR=#0083C1
PWA_BACKGROUND_COLOR=#ffffff

AJUDA_ALTERDATA_URL=https://ajuda.alterdata.com.br
CERCA_TEMPORARIA_DIAS=30

INTEGRACAO_PLOOMES_LABEL="Ploomes"
INTEGRACAO_RD_LABEL="RD Station"
INTEGRACAO_ACTIVE_LABEL="ActiveCampaign"

# Telegram — avisos pra adm/gestor (BotFather → token; chat_id via getUpdates)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ADM=
TELEGRAM_CHAT_GESTOR=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEBOUNCE_MINUTOS=30
TELEGRAM_AVISO_FORA_TERRITORIO=true
TELEGRAM_AVISO_VISITA=true
